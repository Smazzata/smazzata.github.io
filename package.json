{
  "name": "burraco-online",
  "version": "1.0.0",
  "description": "Burraco multiplayer webapp con varianti (Classico FIBUR, a 3, Reale, Buraco Brasiliano Aberto/Fechado)",
  "author": "Muliello S.F.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node server/selftest.js",
    "test:campagna": "node server/campaigntest.js",
    "e2e": "node server/e2etest.js",
    "bench": "node server/botbench.js",
    "playtest": "node server/playtest.js",
    "load": "node server/loadtest.js",
    "ui": "node server/uitest.js",
    "test:rapido": "node -e \"process.env.TEST_RAPIDO=1;require('./server/selftest.js')\"",
    "anim": "node server/animtest.js",
    "suoni": "node scripts/suoni-wav.js",
    "app:www": "node scripts/build-pages.js android-app/www",
    "test:ranked": "node --test server/ranked-test.js",
    "test:risultati": "node --test server/result-progress-test.js",
    "ui:rilascio": "node server/release-ui-test.js",
    "sim:ranked": "node server/ranked-simulation.js",
    "e2e:ranked": "node server/ranked-e2e.js",
    "test:avatar": "node --test server/avatar-catalog-test.js",
    "test:prerilascio": "node --test server/pre-release-test.js server/avatar-catalog-test.js server/result-progress-test.js server/chest-test.js server/chest-e2e-test.js server/cosmetics-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^10.1.7",
    "qrcode-generator": "^1.4.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
